# ============================================================
# Railway Cloudflare Tunnel 环境变量（Node / Railway Xray 可选）
# 在 Railway 服务的 Variables 标签设置，不需要上传本文件
# ============================================================

# ─── 必填 ───────────────────────────────────────────────────

# [必填] 节点 UUID，务必用自己生成的 UUID 并固定
uuid=your-uuid-here

# 默认 node：保留原 VLESS TCP/UDP/XUDP；railway-xray：VLESS + Trojan，仅 TCP。
PROXY_BACKEND=node

# railway-xray 模式可选：省略时 Trojan 密码使用 uuid。
# TROJAN_PASSWORD=your-private-password

# railway-xray 内部后端端口，不得与 PORT 相同，严禁映射为公网入口。
# BACKEND_PORT=3001

# ─── Cloudflare Tunnel 隧道模式 ──────────────────────────────────────────

# 临时隧道始终启动（自动分配 *.trycloudflare.com，重启会变）
# 设置以下两项可额外启动固定隧道（双隧道并行）：

# 固定隧道 Token（从 Cloudflare Zero Trust 获取）
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoixxxx...

# 固定隧道对应的域名
# CLOUDFLARE_TUNNEL_DOMAIN=your-domain.example.com

# ─── 可选 ───────────────────────────────────────────────────

# 节点显示名称前缀
# NAME=my-node

# Cloudflare 优选 IP（同时用于固定和临时隧道链接的连接地址）
# CF_IP=104.16.0.1

# 可选：隧道域名和日志状态目录，默认 /tmp，必须允许 node 用户写入。
# TUNNEL_STATE_DIR=/tmp

# ─── 以下由 Railway 自动管理，不要手动设置 ──────────────────
# PORT
