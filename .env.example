# ============================================================
# Railway Argo VLESS-WS 环境变量
# 在 Railway 服务的 Variables 标签设置，不需要上传本文件
# ============================================================

# ─── 必填 ───────────────────────────────────────────────────

# [必填] 节点 UUID，务必用自己生成的 UUID 并固定
# 生成方式：在线搜 "UUID generator" 或命令行 uuidgen
uuid=your-uuid-here

# ─── Argo 隧道（二选一）──────────────────────────────────────

# 方式一：临时隧道（不设以下两项即默认启用）
# - 自动分配 *.trycloudflare.com 域名
# - 重启后域名会变
# - 适合临时试用

# 方式二：固定隧道（推荐长期使用）
# ARGO_TOKEN=eyJhIjoixxxx...（Cloudflare 隧道 Token）
# ARGO_DOMAIN=your-domain.example.com

# ─── 可选 ───────────────────────────────────────────────────

# 节点显示名称前缀
# NAME=my-node

# Cloudflare 优选 IP（可选，不填则用 Argo 域名作为连接地址）
# 填写后节点链接地址会用此 IP，SNI/Host 仍为 Argo 域名
# 推荐优选 IP 段：104.16.0.0/12, 172.64.0.0/13
# CF_IP=104.16.0.1

# ─── 以下由 Railway 自动管理，不要手动设置 ──────────────────
# PORT（由 Railway 自动注入）
