# Prefer: npm run init -- YOUR_VPS_IP YOUR_REALITY_TLS_HOST phone laptop
# This example intentionally contains no usable default credentials.
SERVER_ADDRESS=
SERVER_PORT=443
# Public hostname reachable from the VPS, TLS 1.3 / HTTP/2; not the VPS itself.
REALITY_SERVER_NAME=
REALITY_PRIVATE_KEY=
REALITY_SHORT_ID=
# Each device requires a unique name and UUID v4. JSON must be single-quoted.
VLESS_CLIENTS='[]'
